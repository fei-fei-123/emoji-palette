{
    // VS Code 调试配置。解释器统一用项目 .venv(见 settings.json)。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶ 运行主程序 (python -m emoji_palette)",
            "type": "debugpy",
            "request": "launch",
            "module": "emoji_palette",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUTF8": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "⚙ 构建数据索引 (build_data.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/build_data.py",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONUTF8": "1" },
            "console": "integratedTerminal"
        },
        {
            "name": "⚙ 构建数据索引 (离线缓存)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/build_data.py",
            "args": ["--offline"],
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONUTF8": "1" },
            "console": "integratedTerminal"
        },
        {
            "name": "🧪 pytest 全部测试",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v", "${workspaceFolder}/tests"],
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONUTF8": "1" },
            "console": "integratedTerminal"
        },
        {
            "name": "📦 生成应用图标 (scripts/make_icon.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/make_icon.py",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONUTF8": "1" },
            "console": "integratedTerminal"
        },
        {
            "name": "📦 打包单文件 exe (PyInstaller)",
            "type": "debugpy",
            "request": "launch",
            "module": "pyinstaller",
            "args": ["--noconfirm", "build.spec"],
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONUTF8": "1" },
            "console": "integratedTerminal"
        }
    ]
}
